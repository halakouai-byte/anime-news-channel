        "our podcast",
        "we are hiring",
        "site update",
        "our youtube channel",
        "newsletter"
      ]
    },
    {
      "action": "reject",
      "code": "R14",
      "name": "شایعه شبکه‌های اجتماعی بدون منبع",
      "patterns": [
        "user on x",
        "on reddit",
        "twitter user",
        "fans on social media",
        "viral post",
        "social media reacts"
      ]
    },
    {
      "action": "reject",
      "code": "R15",
      "name": "خبر غیرانیمه",
      "note": "برای Siliconera: آیتم بدون هیچ کلیدواژه انیمه/مانگا/استودیو → R15. مرز: اقتباس انیمه‌ای، صداپیشه انیمه یا استودیوی انیمه ربط محسوب می‌شود."
    },
    {
      "action": "reject",
      "code": "R16",
      "name": "«به‌روزرسانی» بدون تغییر",
      "patterns": [
        "correction:",
        "updated:",
        "typo fixed",
        "updated with correct"
      ]
    },
    {
      "action": "reject",
      "code": "R17",
      "exception": "منتشر می‌شود اگر: عنوان در franchises.json باشد، یا اولین پخش جهانی/رسمی اثر باشد، یا قرارداد پخش تازه‌ای اعلام شده باشد. در غیر این صورت برای عنوان‌های بزرگ → نامزد Digest.",
      "name": "کاتالوگ روتین",
      "patterns": [
        "now streaming on",
        "now available on",
        "joins the catalog",
        "added to",
        "now on netflix",
        "now on crunchyroll",
        "adds .* anime",
        "adds .* manga"
      ]
    }
