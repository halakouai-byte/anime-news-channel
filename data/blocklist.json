  "version": 1,
  "sensitive_title_patterns": [
    "passed away",
    "has died",
    "dies at",
    "dead at",
    "died at",
    "arrested",
    "arrest",
    "lawsuit",
    "sues",
    "sued",
    "scandal",
    "suicide",
    "sexual assault",
    "indicted",
    "charged with",
    "apologizes for",
    "apologised for"
  ],
  "sensitive_summary_phrases": [
    "passed away",
    "has died",
    "was arrested",
    "filed a lawsuit",
    "sued for",
    "sexual assault",
    "committed suicide",
    "died at the age",
    "dies at",
    "arrested on suspicion"
  ],
  "sensitive_note": "R6 فقط با عبارت‌های خبری چندکلمه‌ای یا کلمه در تیتر (word-boundary) چک می‌شود؛ کلمات تکی مثل dead/death در خلاصه چک نمی‌شوند چون عنوان اثر (The Detective Is Already Dead) یا خلاصه داستان مانگا (harassment at work) مثبت کاذب می‌سازند. مثبت کاذب مشاهده‌شده در dry-run ۲۱ نوامبر ۲۰۲۶: Already Dead / Premature Death / harassment در سیناپس."
}
