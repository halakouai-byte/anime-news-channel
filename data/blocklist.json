{
  "digest_codes": [
    "R2",
    "R3",
    "R17"
  ],
  "hold_codes": [
    "R6",
    "R7"
  ],
  "note": "فهرست حذف ۱۷ دسته (filter-v2 §۲). بررسی حذف پیش از dedupe و پیش از امتیازدهی انجام می‌شود. هر ردشده با کد دلیل در archive.jsonl ثبت می‌شود. action ها: reject (دور ریخته می‌شود)، hold (HOLD انسانی)، digest (نامزد خلاصه جمعه).",
  "rules": [
    {
      "action": "reject",
      "code": "R1",
      "name": "مرور قسمت (episode review)",
      "patterns": [
        "episode review",
        "episode \\d+ review",
        "review: episode",
        "impressions: episode",
        "anime review",
        "episode impressions",
        "manga review",
        "review: ",
        "manga review:"
      ]
    },
    {
      "action": "digest",
      "code": "R2",
      "name": "رتبه‌بندی هفتگی",
      "patterns": [
        "weekly ranking",
        "weekly rankings",
        "top 10 anime of the week",
        "anime rankings",
        "power rankings",
        "fall 2026 rankings",
        "rankings for the week"
      ]
    },
    {
      "action": "digest",
      "code": "R3",
      "exception": "اگر همراه با محتوای تازه باشد (قسمت اضافه، مصاحبه، نسخه کارگردان) خبر محسوب می‌شود.",
      "name": "تاریخ انتشار Blu-ray به‌تنهایی",
      "patterns": [
        "blu-ray release date",
        "blu-ray/dvd",
        "blu-ray box set",
        "dvd release date"
      ]
    },
    {
      "action": "reject",
      "code": "R4",
      "name": "نظرسنجی (poll)",
      "patterns": [
        "poll:",
        "vote for",
        "readers vote",
        "survey results",
        "poll results"
      ]
    },
    {
      "action": "reject",
      "code": "R5",
      "exception": "فقط وقتی با یک خبر اصلی همراه باشد یا خودش یک رویداد خبری باشد (همکاری بزرگ).",
      "name": "مرچ/کالا",
      "patterns": [
        "figure",
        "nendoroid",
        "acrylic stand",
        "plush",
        "merchandise",
        "pre-order",
        "preorder",
        "goods",
        "keychain",
        "tapestr"
      ]
    },
    {
      "action": "hold",
      "code": "R6",
      "name": "خبر حساس",
      "patterns": [
        "dies",
        "dead",
        "passed away",
        "death of",
        "suicide",
        "arrested",
        "arrest",
        "lawsuit",
        "sues",
        "scandal",
        "sexual assault",
        "harassment",
        "abuse allegation",
        "indicted",
        "charged with",
        "controversy",
        "apologizes for"
      ]
    },
    {
      "action": "reject",
      "code": "R7",
      "hold_exception": "اگر فرنچایز در franchises.json باشد و شایعه در دو منبع مستقل Tier 1/2 آمده باشد → HOLD انسانی.",
      "name": "شایعه تاییدنشده",
      "patterns": [
        "rumor",
        "rumour",
        "reportedly",
        "allegedly",
        "sources say",
        "supposed leak",
        "leak suggests",
        "unconfirmed report"
      ]
    },
    {
      "action": "reject",
      "code": "R8",
      "name": "تیتر کلیک‌بیت بدون محتوای تازه",
